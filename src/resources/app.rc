// Fast Viewer — Windows resource script.
// Version metadata + application icon (placeholder pending human approval).
#include <windows.h>
#include "version.h"

// Placeholder icon. Final branding is PENDING HUMAN APPROVAL; this asset is a
// simple, clearly temporary stand-in (dark rounded square + light "F") so the
// release pipeline can be validated end-to-end. Swap this line once a final
// icon is approved — no other code changes needed.
IDI_APP_ICON ICON "fast_viewer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FAST_VIEWER_FILE_VERSION_MS, FAST_VIEWER_FILE_VERSION_LS
 PRODUCTVERSION FAST_VIEWER_FILE_VERSION_MS, FAST_VIEWER_FILE_VERSION_LS
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fast Viewer"
            VALUE "FileVersion",    FAST_VIEWER_VERSION_STRING
            VALUE "InternalName",   "fast_viewer"
            VALUE "OriginalFilename", "fast_viewer.exe"
            VALUE "ProductName",    "Fast Viewer"
            VALUE "ProductVersion", FAST_VIEWER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
